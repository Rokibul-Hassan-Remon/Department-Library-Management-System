@model BookFormDto
@inject CseLibrary.Core.Interfaces.Services.IBookService Books
@inject CseLibrary.Core.Interfaces.Services.IAuthorService Authors
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Book" : "Edit Book";
    var canRegisterAuthor = await Authorization.CanAsync(User, Permissions.Books.Create);
}

<h2>@ViewData["Title"]</h2>
<form asp-action="@(isNew ? "Create" : "Edit")" method="post" enctype="multipart/form-data" class="row g-4">
  <div class="col-lg-8">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CoverImagePath" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
    @* Authors come from the Authors register only (Select2, server search); the chosen order is kept. *@
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-baseline">
            <label for="AuthorIds" class="form-label">Authors</label>
            @if (canRegisterAuthor) { <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="modal" data-bs-target="#authorDialog"><i class="bi bi-person-plus" aria-hidden="true"></i> Register a new author</button> }
        </div>
        <select id="AuthorIds" name="AuthorIds" multiple class="form-select" data-lookup="@Url.Action("Lookup", "Authors")">
            @foreach (var a in await Authors.GetOptionsAsync(Model.AuthorIds)) { <option value="@a.Id" selected>@a.Name</option> }
        </select>
        <div class="form-text">Type to search registered authors; pick several in order. Not listed? Register the author.</div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Isbn" class="form-label">ISBN</label><input asp-for="Isbn" class="form-control" /><span asp-validation-for="Isbn" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" list="categories" />
            <datalist id="categories">@foreach (var c in await Books.GetCategoriesAsync()) { <option value="@c.Name"></option> }</datalist></div>
        <div class="col-md-6 mb-3"><label asp-for="Publisher" class="form-label"></label><input asp-for="Publisher" class="form-control" /></div>
        <div class="col-md-3 mb-3"><label asp-for="Edition" class="form-label"></label><input asp-for="Edition" class="form-control" /></div>
        <div class="col-md-3 mb-3"><label asp-for="PublicationYear" class="form-label">Year</label><input asp-for="PublicationYear" class="form-control" /><span asp-validation-for="PublicationYear" class="text-danger"></span></div>
    </div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
  </div>
  <div class="col-lg-4">
    <div class="card"><div class="card-body">
        <partial name="_ImageInput" model='("cover", Url.Media(Model.CoverImagePath), "Cover", false)' />
    </div></div>
  </div>
  <div class="col-12">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button>
    @if (isNew) { <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a> }
    else { <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a> }
  </div>
</form>
@if (canRegisterAuthor) { <partial name="_AuthorDialog" model="@("pick")" /> }
@section Styles { <link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" /> }
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/select2/dist/js/select2.min.js"></script>
    @if (canRegisterAuthor) { <script src="~/js/author-dialog.js" asp-append-version="true"></script> }
    <script>
        // Registered authors only (server search). No match: offer to register the typed name in the author dialog.
        const $authors = $("#AuthorIds");
        $authors.select2({
            width: "100%",
            placeholder: "Search authors",
            ajax: { url: $authors.data("lookup"), dataType: "json", delay: 250, data: p => ({ term: p.term }) },
            language: {
                noResults: () => window.authorDialog
                    ? $('<span>No registered author matches. <a href="#" class="js-register-author">Register this author</a></span>')
                    : "No registered author matches."
            }
        });
        $(document).on("mousedown", ".js-register-author", e => {
            e.preventDefault();
            const term = $authors.data("select2").$container.find(".select2-search__field").val();
            $authors.select2("close");
            authorDialog.open(term);
        });
        // A new or an existing author chosen in the dialog joins the book's authors.
        document.getElementById("authorDialog")?.addEventListener("author:picked", e => {
            const { id, name } = e.detail;
            const existing = $authors.find(`option[value="${id}"]`);
            if (existing.length) existing.prop("selected", true);
            else $authors.append(new Option(name, id, true, true));
            $authors.trigger("change");
        });
    </script>
}
