@model CseLibrary.Core.Paging.PagedResult<BookListItemDto>
@{
    ViewData["Title"] = "Books";
    var search = ViewData["Search"] as string;
    var categoryId = ViewData["CategoryId"] as int?;
    var categories = (IReadOnlyList<CategoryDto>)ViewData["Categories"]!;
    var canCreate = await Authorization.CanAsync(User, Permissions.Books.Create);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Books</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Book</a> }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="search" value="@search" class="form-control" placeholder="Title, author, ISBN or accession number" /></div>
    <div class="col-md-3"><select name="categoryId" class="form-select"><option value="">All categories</option>@foreach (var c in categories) { <option value="@c.Id" selected="@(c.Id == categoryId)">@c.Name</option> }</select></div>
    <div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search" aria-hidden="true"></i> Search</button></div>
    @if (!string.IsNullOrEmpty(search)) { <div class="col-auto"><a class="btn btn-link" asp-action="Index"><i class="bi bi-x-circle" aria-hidden="true"></i> Clear</a></div> }
</form>

<table class="table table-striped">
    <thead><tr><th>Title</th><th>Authors</th><th>ISBN</th><th>Category</th><th class="text-end">Available / Total</th></tr></thead>
    <tbody>
        @foreach (var b in Model.Items)
        {
            <tr>
                <td>
                    <a class="name-cell" asp-action="Details" asp-route-id="@b.Id">
                        @if (Url.Media(b.CoverImagePath) is { } cover) { <img class="cover-thumb" src="@cover" alt="" loading="lazy" /> }
                        else { <span class="cover-thumb is-empty" aria-hidden="true"><i class="bi bi-book"></i></span> }
                        <span>@b.Title</span>
                    </a>
                </td>
                <td>@b.Authors</td>
                <td>@b.Isbn</td>
                <td>@b.Category</td>
                <td class="text-end">@b.AvailableCopies / @b.TotalCopies</td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-muted">No books found.</td></tr> }
    </tbody>
</table>

<partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.TotalCount)" />
