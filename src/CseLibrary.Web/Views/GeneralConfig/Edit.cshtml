@model UpdateGeneralConfigDto
@{ ViewData["Title"] = "Edit Config"; }

<h2>Edit Config</h2>
<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Key</label><input asp-for="Key" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Value</label><textarea asp-for="Value" class="form-control" rows="3"></textarea></div>
    <div class="mb-3"><label class="form-label">Group</label><input asp-for="Group" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Description</label><input asp-for="Description" class="form-control" /></div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button>
    <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
