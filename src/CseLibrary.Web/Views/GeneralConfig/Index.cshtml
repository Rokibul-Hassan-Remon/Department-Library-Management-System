@model IEnumerable<GeneralConfigDto>
@{ ViewData["Title"] = "General Configs";
   var canCreate = await Authorization.CanAsync(User, Permissions.GeneralConfig.Create);
   var canEdit = await Authorization.CanAsync(User, Permissions.GeneralConfig.Edit);
   var canDelete = await Authorization.CanAsync(User, Permissions.GeneralConfig.Delete);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>General Configs</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Config</a> }
</div>

<table class="table table-striped">
    <thead><tr><th>Group</th><th>Key</th><th>Value</th><th>Description</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Group</td>
                <td>@c.Key</td>
                <td>@c.Value</td>
                <td>@c.Description</td>
                <td class="text-end">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-secondary" title="Edit" aria-label="Edit" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil" aria-hidden="true"></i></a> }
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete" asp-action="Delete" asp-route-id="@c.Id"><i class="bi bi-trash" aria-hidden="true"></i></a> }
                </td>
            </tr>
        }
    </tbody>
</table>
