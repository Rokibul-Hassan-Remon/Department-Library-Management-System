@model IEnumerable<PermissionDto>
@{ ViewData["Title"] = "Permissions";
   var canCreate = await Authorization.CanAsync(User, Permissions.PermissionsModule.Create);
   var canEdit = await Authorization.CanAsync(User, Permissions.PermissionsModule.Edit);
   var canDelete = await Authorization.CanAsync(User, Permissions.PermissionsModule.Delete);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Permissions</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create">+ New Permission</a> }
</div>

<table class="table table-striped">
    <thead><tr><th>Module</th><th>Name</th><th>Display name</th><th>Description</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Module</td>
                <td>@p.Name</td>
                <td>@p.DisplayName</td>
                <td>@p.Description</td>
                <td class="text-end">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Edit</a> }
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id">Delete</a> }
                </td>
            </tr>
        }
    </tbody>
</table>
