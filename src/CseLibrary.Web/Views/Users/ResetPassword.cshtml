@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }

<h2>Reset Password — @Model.UserName</h2>

<form asp-action="ResetPassword" method="post" class="col-md-5">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-key" aria-hidden="true"></i> Reset</button>
    <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
