@model CseLibrary.Core.Paging.PagedResult<UserDto>
@{ ViewData["Title"] = "Users";
   var canCreate = await Authorization.CanAsync(User, Permissions.Users.Create);
   var canEdit = await Authorization.CanAsync(User, Permissions.Users.Edit);
   var canDelete = await Authorization.CanAsync(User, Permissions.Users.Delete);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Users</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create">+ New User</a> }
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>User name</th>
            <th>Email</th>
            <th>Full name</th>
            <th>Roles</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Items)
        {
            <tr>
                <td>@u.UserName</td>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                <td>@string.Join(", ", u.Roles)</td>
                <td>@(u.IsActive ? "Yes" : "No")</td>
                <td class="text-end">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id">Edit</a> }
                    @if (canEdit) { <a class="btn btn-sm btn-outline-warning" asp-action="ResetPassword" asp-route-id="@u.Id">Reset PW</a> }
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@u.Id">Delete</a> }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Users pages" class="d-flex justify-content-between align-items-center">
        <span>Page @Model.Page of @Model.TotalPages (@Model.TotalCount users)</span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
