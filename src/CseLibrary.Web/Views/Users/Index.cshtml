@model CseLibrary.Core.Paging.PagedResult<UserDto>
@{ ViewData["Title"] = "Users";
   var canCreate = await Authorization.CanAsync(User, Permissions.Users.Create);
   var canEdit = await Authorization.CanAsync(User, Permissions.Users.Edit);
   var canDelete = await Authorization.CanAsync(User, Permissions.Users.Delete);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Users</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New User</a> }
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>User name</th>
            <th>Email</th>
            <th>Full name</th>
            <th>Roles</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Items)
        {
            <tr>
                <td>@u.UserName</td>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                <td>@string.Join(", ", u.Roles)</td>
                <td>@(u.IsActive ? "Yes" : "No")</td>
                <td class="text-end">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-secondary" title="Edit" aria-label="Edit" asp-action="Edit" asp-route-id="@u.Id"><i class="bi bi-pencil" aria-hidden="true"></i></a> }
                    @if (canEdit) { <a class="btn btn-sm btn-outline-warning" title="Reset password" aria-label="Reset password" asp-action="ResetPassword" asp-route-id="@u.Id"><i class="bi bi-key" aria-hidden="true"></i></a> }
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete" asp-action="Delete" asp-route-id="@u.Id"><i class="bi bi-trash" aria-hidden="true"></i></a> }
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.TotalCount)" />
