@model UserDto
@{ ViewData["Title"] = "Delete User"; }

<h2>Delete User</h2>
<p class="text-danger">Are you sure you want to delete this user?</p>
<dl class="row">
    <dt class="col-sm-3">User name</dt><dd class="col-sm-9">@Model.UserName</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Full name</dt><dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Roles</dt><dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
    <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a>
</form>
