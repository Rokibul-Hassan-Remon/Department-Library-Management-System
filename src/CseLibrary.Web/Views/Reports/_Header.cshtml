@model string
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model</h2>
    <div class="no-print">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer" aria-hidden="true"></i> Print</button>
        <a class="btn btn-link" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> All reports</a>
    </div>
</div>
