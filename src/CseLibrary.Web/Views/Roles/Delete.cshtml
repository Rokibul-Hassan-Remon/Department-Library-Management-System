@model RoleDto
@{ ViewData["Title"] = "Delete Role"; }

<h2>Delete Role</h2>
<p class="text-danger">Are you sure you want to delete this role?</p>
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Permissions</dt><dd class="col-sm-9">@Model.PermissionIds.Count</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
    <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a>
</form>
