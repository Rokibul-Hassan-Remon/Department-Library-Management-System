@model CreateRoleViewModel
@{
    ViewData["Title"] = "Create Role";
    ViewData["Name"] = Model.Name;
    ViewData["Description"] = Model.Description;
    ViewData["SelectedPermissionIds"] = Model.SelectedPermissionIds;
    ViewData["AvailablePermissions"] = Model.AvailablePermissions;
}

<h2>Create Role</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_RoleForm" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Create</button>
        <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
