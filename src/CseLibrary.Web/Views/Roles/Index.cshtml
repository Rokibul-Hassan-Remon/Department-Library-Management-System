@model IEnumerable<RoleDto>
@{ ViewData["Title"] = "Roles";
   var canCreate = await Authorization.CanAsync(User, Permissions.Roles.Create);
   var canEdit = await Authorization.CanAsync(User, Permissions.Roles.Edit);
   var canDelete = await Authorization.CanAsync(User, Permissions.Roles.Delete);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Roles</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create">+ New Role</a> }
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Name</th><th>Description</th><th>Permissions</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Name</td>
                <td>@r.Description</td>
                <td>@r.PermissionIds.Count</td>
                <td class="text-end">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@r.Id">Edit</a> }
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@r.Id">Delete</a> }
                </td>
            </tr>
        }
    </tbody>
</table>
