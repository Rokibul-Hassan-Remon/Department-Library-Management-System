@model CseLibrary.Core.Paging.PagedResult<LibraryMemberDto>
@{ ViewData["Title"] = "Library Members"; var search = ViewData["Search"] as string;
   var canCreate = await Authorization.CanAsync(User, Permissions.LibraryMembers.Create);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Library Members</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create">+ New Library Member</a> }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="search" value="@search" class="form-control" placeholder="Member code, name or email" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Search</button></div>
</form>

<table class="table table-striped">
    <thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Email</th><th>Status</th><th class="text-end">Books held</th></tr></thead>
    <tbody>
        @foreach (var m in Model.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@m.Id">@m.MemberCode</a></td>
                <td>@m.FullName</td>
                <td>@m.MemberType</td>
                <td>@m.Email</td>
                <td>@(m.IsActive ? "Active" : "Inactive")</td>
                <td class="text-end">@m.ActiveLoans</td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-muted">No members found.</td></tr> }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Library member pages" class="d-flex justify-content-between align-items-center">
        <span>Page @Model.Page of @Model.TotalPages (@Model.TotalCount library members)</span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@search">Previous</a>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@search">Next</a>
            </li>
        </ul>
    </nav>
}
