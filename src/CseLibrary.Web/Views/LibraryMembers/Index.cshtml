@model CseLibrary.Core.Paging.PagedResult<LibraryMemberDto>
@{ ViewData["Title"] = "Library Members"; var search = ViewData["Search"] as string;
   var canCreate = await Authorization.CanAsync(User, Permissions.LibraryMembers.Create);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Library Members</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Library Member</a> }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="search" value="@search" class="form-control" placeholder="Member code, name or email" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search" aria-hidden="true"></i> Search</button></div>
</form>

<table class="table table-striped">
    <thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Email</th><th>Status</th><th class="text-end">Books held</th></tr></thead>
    <tbody>
        @foreach (var m in Model.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@m.Id">@m.MemberCode</a></td>
                <td>@m.FullName</td>
                <td>@m.MemberType</td>
                <td>@m.Email</td>
                <td>@(m.IsActive ? "Active" : "Inactive")</td>
                <td class="text-end">@m.ActiveLoans</td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-muted">No members found.</td></tr> }
    </tbody>
</table>

<partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.TotalCount)" />
