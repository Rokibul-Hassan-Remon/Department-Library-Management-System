@model LibraryMemberDetailsDto
@{ ViewData["Title"] = Model.FullName; }

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2>@Model.FullName <small class="text-muted">@Model.MemberCode</small></h2>
        <div>@Model.MemberType · @(Model.IsActive ? "Active" : "Inactive") · @Model.Email @Model.Phone</div>
    </div>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this member?');">
            <button class="btn btn-outline-danger">Delete</button>
        </form>
    </div>
</div>

@if (Model.IsActive)
{
    <form asp-controller="Loans" asp-action="Issue" asp-route-returnUrl="@Url.Action("Details", new { id = Model.Id })" method="post" class="row g-2 align-items-end mb-4">
        <input type="hidden" name="MemberCode" value="@Model.MemberCode" />
        <div class="col-md-4"><label class="form-label">Issue a copy (accession no.)</label><input name="AccessionNumber" class="form-control" required maxlength="50" /></div>
        <div class="col-md-2"><button class="btn btn-primary">Issue</button></div>
    </form>
}

<h4>Loans <small class="text-muted">(@Model.ActiveLoans held; latest 100 shown)</small></h4>
<partial name="_LoanTable" model="Model.Loans" />

<p class="mt-4"><a asp-action="Index">Back to members</a></p>
