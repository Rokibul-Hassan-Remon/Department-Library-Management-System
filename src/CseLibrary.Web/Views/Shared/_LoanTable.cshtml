@model IEnumerable<LoanDto>
@{
    var today = DateOnly.FromDateTime(DateTime.Now);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var canRenew = await Authorization.CanAsync(User, Permissions.Lending.Issue);
    var canReturn = await Authorization.CanAsync(User, Permissions.Lending.Return);
}
<table class="table table-sm table-striped">
    <thead><tr><th>Library Member</th><th>Book</th><th>Accession no.</th><th>Issued</th><th>Due</th><th>Returned</th><th></th></tr></thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr class="@(l.IsOverdue(today) ? "table-danger" : "")">
                <td><a asp-controller="LibraryMembers" asp-action="Details" asp-route-id="@l.LibraryMemberId">@l.MemberCode</a> @l.MemberName</td>
                <td><a asp-controller="Books" asp-action="Details" asp-route-id="@l.BookId">@l.BookTitle</a></td>
                <td>@l.AccessionNumber</td>
                <td>@l.IssueDateUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                <td>@l.DueDate.ToString("yyyy-MM-dd") @(l.IsOverdue(today) ? "(overdue)" : "") @(l.RenewCount > 0 ? $"· renewed {l.RenewCount}" : "")</td>
                <td>@l.ReturnDateUtc?.ToLocalTime().ToString("yyyy-MM-dd")</td>
                <td class="text-end text-nowrap">
                    @if (l.ReturnDateUtc == null)
                    {
                        if (canRenew)
                        {
                            <form asp-controller="Loans" asp-action="Renew" asp-route-id="@l.Id" asp-route-returnUrl="@returnUrl" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary">Renew</button>
                            </form>
                        }
                        if (canReturn)
                        {
                            <form asp-controller="Loans" asp-action="Return" asp-route-id="@l.Id" asp-route-returnUrl="@returnUrl" method="post" class="d-inline-flex gap-1">
                                <select name="condition" class="form-select form-select-sm w-auto"><option value="Good">Good</option><option value="Damaged">Damaged</option></select>
                                <button class="btn btn-sm btn-success">Return</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="7" class="text-muted">No loans.</td></tr> }
    </tbody>
</table>
