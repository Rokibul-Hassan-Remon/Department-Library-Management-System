@model (int Page, int TotalPages, int TotalCount)
@{
    // Keeps the current filters; only "page" changes.
    string Link(int page) => Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path,
        Context.Request.Query.Where(q => q.Key != "page")
            .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v)))
            .Append(new("page", page.ToString())));
}
<nav class="d-flex justify-content-between align-items-center">
    <span>Page @Model.Page of @Math.Max(Model.TotalPages, 1) (@Model.TotalCount rows)</span>
    @if (Model.TotalPages > 1)
    {
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)">Previous</a></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)">Next</a></li>
        </ul>
    }
</nav>
