@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
@* D-34: no exception details here, only the Reference ID that is in the server log. *@
<h1 class="text-danger">Something went wrong.</h1>
<p>An unexpected error occurred while processing your request. Please try again later.</p>

@if (Model.ShowRequestId)
{
    <p>If the problem continues, give this Reference ID to the system administrator:
        <strong>Reference ID:</strong> <code>@Model.RequestId</code></p>
}
<p><a asp-controller="Home" asp-action="Index">Back to Home</a></p>
