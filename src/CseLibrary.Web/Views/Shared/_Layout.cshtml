@using Microsoft.AspNetCore.Identity
@using CseLibrary.Core.Entities
@using CseLibrary.Core.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@functions {
    private Task<bool> Can(string permission) => Authorization.CanAsync(User, permission);

    // Highlights the sidebar link of the current page; action is only needed where one controller has two links.
    private string Active(string controller, string? action = null) =>
        string.Equals(ViewContext.RouteData.Values["controller"] as string, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(ViewContext.RouteData.Values["action"] as string, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";

    // Portal holds both "My books" and "Registrations", so only there does the action decide.
    private string ActiveLink(string controller, string action) => Active(controller, controller == "Portal" ? action : null);
}
@{
    var signedIn = SignInManager.IsSignedIn(User);

    // Sidebar groups: only links the user may open, a group only if it has one. The current page's group starts open.
    var groups = new List<(string Id, string Title, string Icon, List<(string Text, string Icon, string Controller, string Action)> Links)>();
    if (signedIn)
    {
        var library = new List<(string, string, string, string)>();
        if (await Can(Permissions.Books.View))
        {
            library.Add(("Books", "bi-book", "Books", "Index"));
            library.Add(("Authors", "bi-person-lines-fill", "Authors", "Index"));
        }
        if (await Can(Permissions.Lending.View)) library.Add(("Loans", "bi-arrow-left-right", "Loans", "Index"));
        if (await Can(Permissions.LibraryMembers.View)) library.Add(("Library Members", "bi-person-vcard", "LibraryMembers", "Index"));
        if (await Can(Permissions.Registrations.Review)) library.Add(("Registrations", "bi-person-check", "Portal", "Pending"));
        if (await Can(Permissions.Reports.View)) library.Add(("Reports", "bi-bar-chart", "Reports", "Index"));

        var admin = new List<(string, string, string, string)>();
        if (await Can(Permissions.Users.View)) admin.Add(("Users", "bi-people", "Users", "Index"));
        if (await Can(Permissions.Roles.View)) admin.Add(("Roles", "bi-shield-lock", "Roles", "Index"));
        if (await Can(Permissions.PermissionsModule.View)) admin.Add(("Permissions", "bi-key", "Permissions", "Index"));
        if (await Can(Permissions.GeneralConfig.View))
        {
            admin.Add(("Configs", "bi-gear", "GeneralConfig", "Index"));
            admin.Add(("Policies", "bi-sliders", "Policies", "Index"));
        }

        if (library.Count > 0) groups.Add(("nav-library", "Library", "bi-collection", library));
        if (admin.Count > 0) groups.Add(("nav-admin", "Administration", "bi-shield-check", admin));
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CSE Library</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    @* Page library CSS before site.css, so the theme overrides it. *@
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CseLibrary.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to content</a>

    @* Static column on large screens, slide-in offcanvas below (CSS in site.css). *@
    <aside class="sidebar offcanvas offcanvas-start" id="sidebar" tabindex="-1" aria-label="Main navigation">
        <div class="sidebar-brand">
            <a asp-controller="Home" asp-action="Index" title="Home" aria-label="CSE Library home">
                <span class="brand-mark"><i class="bi bi-book-half" aria-hidden="true"></i></span>
                <span class="brand-text">CSE Library<small>Department of CSE</small></span>
            </a>
            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
        </div>

        <nav class="sidebar-nav" id="sidebarNav">
            @if (signedIn)
            {
                <a class="nav-link @Active("Portal", "MyLoans")" asp-controller="Portal" asp-action="MyLoans"><i class="bi bi-bookmark" aria-hidden="true"></i> My books</a>
            }

            @foreach (var g in groups)
            {
                var open = g.Links.Any(l => ActiveLink(l.Controller, l.Action) != "");
                <button class="nav-link nav-group @(open ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                        data-bs-target="#@g.Id" aria-expanded="@(open ? "true" : "false")" aria-controls="@g.Id">
                    <i class="bi @g.Icon" aria-hidden="true"></i> @g.Title
                    <i class="bi bi-chevron-down nav-caret" aria-hidden="true"></i>
                </button>
                <div class="collapse @(open ? "show" : "")" id="@g.Id" data-bs-parent="#sidebarNav">
                    <div class="nav-sub">
                        @foreach (var l in g.Links)
                        {
                            <a class="nav-link @ActiveLink(l.Controller, l.Action)" href="@Url.Action(l.Action, l.Controller)"><i class="bi @l.Icon" aria-hidden="true"></i> @l.Text</a>
                        }
                    </div>
                </div>
            }
        </nav>
    </aside>

    <div class="app-main">
        <header class="topbar">
            <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <a class="topbar-brand d-lg-none" asp-controller="Home" asp-action="Index">CSE Library</a>

            <div class="ms-auto d-flex align-items-center gap-2">
                @if (signedIn)
                {
                    <div class="dropdown">
                        <button class="btn user-menu dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (Url.Media(User.FindFirst(AppClaims.Photo)?.Value) is { } photo) { <img class="avatar avatar-photo" src="@photo" alt="" /> }
                            else { <span class="avatar" aria-hidden="true">@User.Identity!.Name![..1].ToUpperInvariant()</span> }
                            <span class="d-none d-sm-inline">@User.Identity!.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person" aria-hidden="true"></i> My profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key" aria-hidden="true"></i> Change password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Portal" asp-action="Register"><i class="bi bi-person-plus" aria-hidden="true"></i> Register</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Login</a>
                }
            </div>
        </header>

        <main role="main" id="main" class="content">
            <partial name="_Toasts" />
            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; @DateTime.Now.Year CSE Department Library
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/image-input.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
