@using Microsoft.AspNetCore.Identity
@using CseLibrary.Core.Entities
@using CseLibrary.Core.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@functions {
    private Task<bool> Can(string permission) => Authorization.CanAsync(User, permission);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DefaultTemplate</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CseLibrary.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">DefaultTemplate</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (await Can(Permissions.Users.View))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Users" asp-action="Index">Users</a></li>
                            }
                            @if (await Can(Permissions.Roles.View))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Roles" asp-action="Index">Roles</a></li>
                            }
                            @if (await Can(Permissions.PermissionsModule.View))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Permissions" asp-action="Index">Permissions</a></li>
                            }
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Portal" asp-action="MyLoans">My books</a></li>
                            @if (await Can(Permissions.Registrations.Review))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Portal" asp-action="Pending">Registrations</a></li>
                            }
                            @if (await Can(Permissions.Lending.View))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Loans" asp-action="Index">Loans</a></li>
                            }
                            @if (await Can(Permissions.LibraryMembers.View))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="LibraryMembers" asp-action="Index">Library Members</a></li>
                            }
                            @if (await Can(Permissions.Books.View))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Books" asp-action="Index">Books</a></li>
                            }
                            @if (await Can(Permissions.GeneralConfig.View))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="GeneralConfig" asp-action="Index">Configs</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Policies" asp-action="Index">Policies</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="ChangePassword">@User.Identity!.Name</a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Portal" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <partial name="_Toasts" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - DefaultTemplate
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
