@model CseLibrary.Core.Paging.PagedResult<AuthorListItemDto>
@{
    ViewData["Title"] = "Authors";
    var search = ViewData["Search"] as string;
    var canCreate = await Authorization.CanAsync(User, Permissions.Books.Create);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Authors</h2>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Author</a> }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="search" value="@search" class="form-control" placeholder="Author name" aria-label="Author name" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search" aria-hidden="true"></i> Search</button></div>
    @if (!string.IsNullOrEmpty(search)) { <div class="col-auto"><a class="btn btn-link" asp-action="Index"><i class="bi bi-x-circle" aria-hidden="true"></i> Clear</a></div> }
</form>

<table class="table table-striped">
    <thead><tr><th>Name</th><th class="text-end">Books</th></tr></thead>
    <tbody>
        @foreach (var a in Model.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@a.Id">@a.Name</a></td>
                <td class="text-end">@a.BookCount</td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="2" class="text-muted">No authors found.</td></tr> }
    </tbody>
</table>

<partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.TotalCount)" />
