@model AuthorFormDto
@{ var isNew = Model.Id == 0; ViewData["Title"] = isNew ? "New Author" : "Edit Author"; }

<h2>@ViewData["Title"]</h2>
<form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Author name</label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button>
    @if (isNew) { <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a> }
    else { <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</a> }
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
