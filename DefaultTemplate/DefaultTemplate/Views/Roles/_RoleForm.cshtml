@using DefaultTemplate.ViewModels
@{
    var name = ViewData["Name"] as string;
    var description = ViewData["Description"] as string;
    var selected = ViewData["SelectedPermissionIds"] as IList<int> ?? new List<int>();
    var available = ViewData["AvailablePermissions"] as IList<Default.core.DTOs.PermissionDto> ?? new List<Default.core.DTOs.PermissionDto>();
}

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Name</label>
        <input name="Name" value="@name" class="form-control" required />
    </div>
    <div class="col-md-6">
        <label class="form-label">Description</label>
        <input name="Description" value="@description" class="form-control" />
    </div>
    <div class="col-12">
        <label class="form-label">Permissions</label>
        @foreach (var group in available.GroupBy(p => p.Module ?? "Other"))
        {
            <fieldset class="border rounded p-2 mb-2">
                <legend class="float-none w-auto px-2 fs-6">@group.Key</legend>
                @foreach (var p in group)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedPermissionIds" value="@p.Id"
                            @(selected.Contains(p.Id) ? "checked" : "") />
                        <label class="form-check-label">@(p.DisplayName ?? p.Name)</label>
                    </div>
                }
            </fieldset>
        }
    </div>
</div>
