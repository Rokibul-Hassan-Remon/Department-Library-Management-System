@model IEnumerable<UserDto>
@{ ViewData["Title"] = "Users"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Users</h2>
    <a class="btn btn-primary" asp-action="Create">+ New User</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>User name</th>
            <th>Email</th>
            <th>Full name</th>
            <th>Roles</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.UserName</td>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                <td>@string.Join(", ", u.Roles)</td>
                <td>@(u.IsActive ? "Yes" : "No")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-warning" asp-action="ResetPassword" asp-route-id="@u.Id">Reset PW</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@u.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
